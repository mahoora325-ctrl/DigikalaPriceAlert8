<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.DigikalaPriceAlert" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/background</item>
        <!-- رنگ‌بندی این برنامه فقط برای حالت روشن طراحی شده؛ اگر از تم
             DayNight استفاده می‌شد، وقتی گوشی در حالت تاریک باشد، ویجت‌های
             بدون استایل اختصاصی (مثل Spinner) خودشان را با رنگ‌های حالت تاریک
             (مثلاً متن سفید) نشان می‌دادند در حالی که پس‌زمینه‌ی ما همچنان
             روشن می‌ماند و متن ناخوانا می‌شد. برای جلوگیری از این ناهماهنگی،
             برنامه همیشه در حالت روشن می‌ماند. -->
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColor">@color/text_primary</item>
        <!-- برنامه فقط فارسی است؛ صرف‌نظر از زبان سیستم گوشی (فارسی یا انگلیسی)
             همیشه راست‌به‌چپ نمایش داده شود تا ترتیب نمایش (مثل تاریخچه‌ی
             قیمت) روی همه‌ی گوشی‌ها یکسان بماند. -->
        <item name="android:layoutDirection">rtl</item>
        
        <!-- تغییر فونت به Vazirmatn برای نمایش بهتر اعداد فارسی -->
        <item name="android:fontFamily">@font/vazirmatn</item>
        <item name="fontFamily">@font/vazirmatn</item>
    </style>
</resources>
